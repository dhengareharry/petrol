# Copy to .env.local (git-ignored) and set the address of your backend API.
# - Web / iOS simulator:      http://localhost:4100/api/v1
# - Android emulator:         http://10.0.2.2:4100/api/v1
# - Real phone with Expo Go:  http://<your PC's Wi-Fi IP>:4100/api/v1   (phone and PC on the same Wi-Fi)
# - Deployed backend:         https://your-service.onrender.com/api/v1
# Restart Expo after changing this:  npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:4100/api/v1
